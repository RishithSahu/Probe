# Web Security Agent service (optional — see APE_WEB_AGENT_SERVICE_URL in
# .env.example). Carries Katana so it isn't installed in the orchestrator
# image. If the Katana download step fails (e.g. no network access at build
# time), the agent still runs using its documented synthetic-fixture
# fallback (APE_WEB_AGENT_USE_FIXTURES=true) rather than failing to start.
FROM python:3.12-slim

WORKDIR /srv/app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

ARG KATANA_VERSION=1.1.2
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then KATANA_ARCH=amd64; else KATANA_ARCH=arm64; fi \
    && curl -fsSL -o /tmp/katana.zip \
         "https://github.com/projectdiscovery/katana/releases/download/v${KATANA_VERSION}/katana_${KATANA_VERSION}_linux_${KATANA_ARCH}.zip" \
    && unzip -o /tmp/katana.zip -d /usr/local/bin katana \
    && chmod +x /usr/local/bin/katana \
    || echo "WARNING: katana download failed at build time; agent will use synthetic fixtures" \
    && rm -f /tmp/katana.zip \
    && apt-get purge -y curl unzip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY app ./app

EXPOSE 8001
CMD ["uvicorn", "app.agents.web_security.service:app", "--host", "0.0.0.0", "--port", "8001"]
