# Copy to .env and adjust for your environment.
# All variables are prefixed APE_ and map directly onto app/core/config.py::Settings.

APE_APP_NAME=autonomous-pentest-engine
APE_ENVIRONMENT=development

# --- Database -----------------------------------------------------------------
# SQLite by default — no separate database service to run. docker-compose.yml
# overrides this to an absolute path under the bind-mounted evidence volume
# (sqlite:////data/evidence/ape.db) so the file persists and is inspectable
# on the host. Running outside Docker, the relative default below is fine.
# To use PostgreSQL instead: APE_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# (uncomment psycopg2-binary in requirements.txt too).
APE_DATABASE_URL=sqlite:///evidence/ape.db

# --- Storage --------------------------------------------------------------------
APE_EVIDENCE_DIR=/data/evidence
APE_INPUTS_DIR=/data/inputs
APE_NETWORK_GRAPH_DIR=/data/inputs/network_graphs
APE_BINARIES_DIR=/data/inputs/binaries
APE_REPORTS_DIR=/data/evidence/reports

# --- Web Security Agent ---------------------------------------------------------
APE_KATANA_BINARY=katana
APE_ZAP_API_URL=http://zap:8080
APE_ZAP_API_KEY=
APE_HTTPX_TIMEOUT_SECONDS=10.0
# When true (default), a missing Katana/ZAP falls back to documented
# synthetic fixtures instead of failing the task. Set false once real tool
# integrations are confirmed working in the assessment environment.
APE_WEB_AGENT_USE_FIXTURES=true

# --- Binary Analysis Agent -------------------------------------------------------
# Path to a Ghidra install containing support/analyzeHeadless. Leave blank to
# use the synthetic analysis fixture (APE_BINARY_AGENT_USE_FIXTURES=true).
APE_GHIDRA_INSTALL_DIR=
APE_GHIDRA_PROJECT_DIR=/data/evidence/ghidra_projects
APE_BINARY_AGENT_USE_FIXTURES=true
APE_BINARY_ANALYSIS_TIMEOUT_SECONDS=300.0

# --- Orchestrator -----------------------------------------------------------------
APE_AGENT_TASK_TIMEOUT_SECONDS=600.0
APE_MAX_CONCURRENT_AGENT_TASKS=4

# --- Safety defaults (overridden per-assessment by AssessmentPolicy in the
# POST /assessments request body — these are only the application-level
# fallback, never a substitute for setting the policy explicitly) ----------
APE_DEFAULT_ACTIVE_WEB_VERIFICATION_ENABLED=false
